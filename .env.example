BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
ADMIN_TELEGRAM_IDS=
PHONE_HASH_SECRET=
# Required: base64-encoded 32-byte AES-GCM key. Generate with:
# openssl rand -base64 32
ANSWER_ENCRYPTION_KEY=

SQLITE_PATH=/data/wrnrs.sqlite3
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=wrnrs
MINIO_SECRET_KEY=change-me-in-production
MINIO_BUCKET=wrnrs-assets
MINIO_USE_SSL=false

DONATION_MONOBANK_URL=
DONATION_CARD_NUMBER=

CARD_FONT_PATH=assets/fonts/Nunito/static/Nunito-Regular.ttf
FEATURE_INLINE_MODE=false

POSITIONS_CATALOG_PATH=content/positions.v1.json
# Bucket and key prefix the positions catalog's images live under in MinIO.
# `go run ./cmd/ingest-positions --seed-only` uploads the already-downloaded
# local images (positions-images/) to this bucket/prefix; it does not
# re-crawl the source site. Changing POSITIONS_PREFIX away from its default
# also requires re-seeding, since content/positions.v1.json's media keys
# were written with the default prefix baked in.
POSITIONS_BUCKET=wrnrs-assets
POSITIONS_PREFIX=positions/

WISHES_CATALOG_PATH=content/wishes.v1.json

PLAY_CATALOG_PATH=content/play.v1.json
